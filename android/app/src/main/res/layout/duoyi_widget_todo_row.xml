<?xml version="1.0" encoding="utf-8"?>
<!--
  待办集合的单行（RemoteViewsService item）：
  轻 marker（3dp 竖条）+ 单行标题。行高由 factory 按真实行高与 fontScale 设置
  minHeight（>= 32dp），文字 maxLines=1 + ellipsize=end + includeFontPadding=false，
  绝不出现半行被裁或空白占位行。不做完成圈：点击整行进 App 详情。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_row_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_todo_row_marker"
        android:layout_width="3dp"
        android:layout_height="13dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_apple_divider"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_todo_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#1C1C1E"
        android:textSize="12sp" />
</LinearLayout>
