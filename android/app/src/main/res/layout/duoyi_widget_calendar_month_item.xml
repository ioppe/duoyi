<?xml version="1.0" encoding="utf-8"?>
<!--
  月历集合的一项：一整月。
  自身带本地化月份标题 + 星期表头 + 完整的 4~6 周（由 provider addView 逐行加入
  widget_calendar_month_grid）。高度 wrap_content：短实例时整月仍完整，由 ListView
  整体滚动承担，绝不删周、绝不裁日期。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_month_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/widget_calendar_month_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#1C1C1E"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_calendar_month_item_weekday_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="一"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="二"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="三"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="四"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="五"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="六"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_calendar_month_item_weekday_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="日"
            android:textColor="#6E6E73"
            android:textSize="8.5sp" />
    </LinearLayout>

    <!-- 整月容器：provider 逐行 addView 进来，行数即该月的 4~6 周。 -->
    <LinearLayout
        android:id="@+id/widget_calendar_month_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="false"
        android:orientation="vertical" />
</LinearLayout>
