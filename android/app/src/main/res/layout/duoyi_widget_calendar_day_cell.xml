<?xml version="1.0" encoding="utf-8"?>
<!--
  月历集合的单日格子（等宽 7 列之一）：
  角标（事项数）在上、日期在下，两者纵向排列不重叠；空白保留位由 provider 置
  INVISIBLE 保持列位置。行高由 provider 用 setMinimumHeight 设为
  "日期行 + 角标行 + 间隔"，因此 0 事项时角标 GONE 也不会让该行塌陷。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_item_day_cell"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_calendar_item_day_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF6B6B"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_calendar_item_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#333333"
        android:textSize="11sp" />
</LinearLayout>
