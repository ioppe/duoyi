<?xml version="1.0" encoding="utf-8"?>
<!--
  月历的单日格子：等宽 7 列之一。
  角标（事项数）固定在上方独立行区域右对齐，日期固定在下方居中，两者不重叠；
  空白保留位由 RemoteViews 置为 INVISIBLE，保持列位置。字体尺寸每次刷新由
  Provider 按真实 fontScale 与可用高度设置。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_day_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <TextView
        android:id="@+id/widget_calendar_day_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="2dp"
        android:layout_marginRight="2dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF6B6B"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_calendar_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#333333"
        android:textSize="11sp" />

</FrameLayout>
