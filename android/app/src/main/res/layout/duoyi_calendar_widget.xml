<?xml version="1.0" encoding="utf-8"?>
<!--
  月历小组件（Apple 风，单月原尺寸）：内边距 <=12dp，顶栏 18dp logo + 13sp 月份标题
  + 小号「今天」（minHeight 22dp）；星期表头 9sp（紧凑 8.5sp），单月网格 weight=1
  吃掉底栏以上全部剩余高度，按 4~6 周等分、完整 1..last 不删周。旧 widget_calendar_title
  与纵向集合 widget_calendar_list 保留 ID / 类型但 GONE；横向翻月未实现（RemoteViews
  没有标准水平手势控件），因此不放左右箭头。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_apple_bg_light"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <ImageView
        android:id="@+id/widget_theme_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_calendar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/widget_calendar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_brand_logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/duoyi_widget_logo" />

            <TextView
                android:id="@+id/widget_calendar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="多仪"
                android:textColor="#FF6B6B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_calendar_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="2026年5月"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_calendar_today_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_apple_track_light"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="22dp"
                android:minWidth="40dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="今天"
                android:textColor="#C95455"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 星期表头：7 个等宽 TextView，文字与字号由 provider 写入（标准 9sp）。 -->
        <LinearLayout
            android:id="@+id/widget_calendar_weekday_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_calendar_weekday_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="一"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="二"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="三"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="四"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="五"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="六"
                android:textColor="#6E6E73"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_calendar_weekday_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="日"
                android:textColor="#6E6E73"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 纵向集合：ID / ListView 类型保留给升级兼容与 CalendarCollectionFactory，
             单月布局不再绑定 adapter（provider 置 GONE），因此不占任何高度。 -->
        <ListView
            android:id="@+id/widget_calendar_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:cacheColorHint="@null"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- 单月网格容器：weight=1 吃掉底栏以上全部剩余高度，provider 按真实 4~6 周
             addView 等分每周，完整 1..lastDay 不删周。 -->
        <LinearLayout
            android:id="@+id/widget_calendar_month_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="vertical" />

        <!-- 历史兼容的多行等宽网格：ID/类型保留，永远 GONE。 -->
        <TextView
            android:id="@+id/widget_calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:text="一 二 三 四 五 六 日"
            android:textColor="#1C1C1E"
            android:textSize="11sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_calendar_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="本月日期 · 今日已标记"
            android:textColor="#C95455"
            android:textSize="10sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/widget_calendar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_calendar_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_apple_track_light"
            android:gravity="center"
            android:minHeight="28dp"
            android:orientation="horizontal"
            android:paddingLeft="3dp"
            android:paddingTop="2dp"
            android:paddingRight="3dp"
            android:paddingBottom="2dp"
            android:weightSum="4">

            <TextView
                android:id="@+id/widget_calendar_nav_todo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="待办"
                android:textColor="#6E6E73"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_calendar_nav_habit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="习惯"
                android:textColor="#6E6E73"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_calendar_nav_calendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="日历"
                android:textColor="#C95455"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_calendar_nav_focus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="专注"
                android:textColor="#6E6E73"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
