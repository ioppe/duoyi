# Copy to backend/.env (or select a private file with DUOYI_ENV_FILE).
# Strict KEY=value syntax; matching single/double quotes and empty values work.
# No shell evaluation, interpolation, export statements, or inline comments.
# Process environment > this file > public deployment profile > schema defaults.
# Keep this private file out of version control. Never put secrets in deployment.json.

ADMIN_BOOTSTRAP_USER=admin
# Optional: on a genuinely fresh DB, empty/unset generates a random password once.
# Retrieve username/password locally from <DUOYI_DB_PATH>.bootstrap-admin.json (0600).
# Default file: backend/duoyi.db.bootstrap-admin.json. Explicit passwords create no file.
# Existing installations never create/reset/promote bootstrap accounts.
ADMIN_BOOTSTRAP_PASSWORD=
# Existing installations MUST retain their original salt across upgrades.
# Omitting this retains the legacy compatibility salt; do not set a new/empty salt.
# PASSWORD_HASH_SALT=

# Omit paths to use backend/duoyi.db, backups/, uploads/avatars/, mobile_apps/.
# DUOYI_DB_PATH=/srv/duoyi/duoyi.db
# SERVER_BACKUP_DIR=/srv/duoyi/backups
# DUOYI_AVATAR_UPLOAD_DIR=/srv/duoyi/uploads/avatars
# DUOYI_MOBILE_APK_DIR=/srv/duoyi/mobile_apps
# Optional public JSON profile; an explicitly selected missing file is an error.
# DUOYI_CONFIG_FILE=../config/deployment.json
# Omit to derive from the public profile. Empty disables cross-origin access/updates.
# CORS_ORIGINS=https://app.example.com
# APP_UPDATE_REPOSITORY=your-account/your-repository

SESSION_ONLINE_SECONDS=300
FOCUS_ROOM_ONLINE_SECONDS=180
FOCUS_FRIEND_REQUEST_LIMIT_PER_DAY=20
FOCUS_ROOM_MAX_WEEKLY_SECONDS=302400
FOCUS_ROOM_MAX_SESSION_COUNT=1000
FOCUS_ROOM_HEARTBEAT_THROTTLE_SECONDS=10
FOCUS_ROOM_SESSION_JUMP_WINDOW_SECONDS=300
FOCUS_ROOM_MAX_SESSION_COUNT_JUMP=20
REMINDER_EMAIL_POLL_SECONDS=60
# Version/build fall back to pubspec.yaml, or 0.0.0/0 for a standalone backend.
# APP_CURRENT_VERSION=0.0.0
# APP_CURRENT_VERSION_CODE=0
APP_PACKAGE_NAME=com.duoyi.duoyi
GIT_SHA=
BUILD_TIME=

ALLOW_PUBLIC_REGISTRATION=true
INVITE_CODE_REQUIRED=false
# REGISTRATION_INVITE_REQUIRED=false
# Explicit presence also disables the historical one-time default-on migration.
REGISTRATION_EMAIL_REQUIRED=true

# Values below only seed missing DB settings. Admin changes persist across restarts.
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini

DUOYI_TITLE=多仪
EMAIL_SENDER_NAME=多仪
EMAIL_SERVICE_ENABLED=true
# Complete SMTP credentials select SMTP as the primary account-mail provider.
# EMAIL_CODE_PRIMARY_PROVIDER=smtp
EMAIL_CODE_BACKUP_PROVIDER=resend
EMAIL_CODE_ACTIVE_SLOT=primary
EMAIL_AUTO_SWITCH_ENABLED=false
# Historical SMTP_*, MAIL_*, EMAIL_ADDRESS/EMAIL_PASSWORD aliases are supported.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_USE_SSL=true
SYSTEM_NOTICE_EMAIL_TO=

OPENCLAW_MAIL_ENABLED=false
OPENCLAW_MAIL_USER=
OPENCLAW_MAIL_API_KEY=
# No script is assumed; configure your own tool before enabling this provider.
OPENCLAW_MAIL_SCRIPT=
OPENCLAW_MAIL_NODE=node
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=
# Empty by default: configure a verified sender in this file or the admin panel.
RESEND_FROM=
HERMES_BASE_URL=
HERMES_API_KEY=

SERVER_BACKUP_ENABLED=true
SERVER_BACKUP_INTERVAL_MINUTES=720
SERVER_BACKUP_RETAIN_DAYS=14
OPENLIST_BACKUP_ENABLED=false
OPENLIST_WEBDAV_URL=
OPENLIST_PUBLIC_URL=
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
OPENLIST_BACKUP_PATH=/duoyi-backups

# Omit per-channel SMTP/from values to inherit account SMTP settings.
BACKUP_EMAIL_ENABLED=false
BACKUP_EMAIL_TO=
# BACKUP_EMAIL_FROM=
# BACKUP_EMAIL_SMTP_HOST=
# BACKUP_EMAIL_SMTP_PORT=465
# BACKUP_EMAIL_SMTP_USERNAME=
# BACKUP_EMAIL_SMTP_PASSWORD=
# BACKUP_EMAIL_SMTP_USE_SSL=true
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_TO=
# REMINDER_EMAIL_FROM=
# REMINDER_EMAIL_SMTP_HOST=
# REMINDER_EMAIL_SMTP_PORT=465
# REMINDER_EMAIL_SMTP_USERNAME=
# REMINDER_EMAIL_SMTP_PASSWORD=
# REMINDER_EMAIL_SMTP_USE_SSL=true
